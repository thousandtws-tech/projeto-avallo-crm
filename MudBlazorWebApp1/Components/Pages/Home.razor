@page "/"

<PageTitle>SaaS | Operacao B2B</PageTitle>

<div class="landing-shell">
    <nav>
        <a class="brand" href="/"><span class="brand-mark">N</span><span>Nucleo</span></a>
        <div>
            <MudButton Href="/login" Variant="Variant.Text">Entrar</MudButton>
            <MudButton Href="/register" Variant="Variant.Filled" Color="Color.Primary">Criar workspace</MudButton>
        </div>
    </nav>
    <main>
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">Operacao B2B, sem fronteiras de dados
        </MudChip>
        <h1>Clareza para vender.<br /><em>Controle para crescer.</em></h1>
        <p>Um workspace seguro para sua equipe comercial e contabil, com acesso por papel e isolamento completo entre
            clientes.</p>
            <div class="landing-actions">
                <MudButton Href="/register" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">Comecar agora
                </MudButton>
                <MudButton Href="/login" Variant="Variant.Outlined" Size="Size.Large">Ja tenho uma conta</MudButton>
            </div>
        </main>
    </div>
