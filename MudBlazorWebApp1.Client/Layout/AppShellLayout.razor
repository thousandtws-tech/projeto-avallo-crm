@implements IDisposable
@inject AuthService Auth
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject AppLocalizer Text
@inject IJSRuntime JavaScript

<MudThemeProvider Theme="Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="app-shell">
    <MudAppBar Elevation="3" Class="topbar">
        <MudTooltip Text="Abrir menu de navegacao" Placement="Placement.Bottom">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="ToggleDrawer" Class="mobile-menu" />
        </MudTooltip>
        <MudText Typo="Typo.h6" Class="topbar-context">@Text[PageContext]</MudText>
        <MudSpacer />
        <MudTooltip Text="Alternar idioma" Placement="Placement.Bottom">
            <MudMenu Variant="Variant.Text" Dense Class="language-menu" AriaLabel="@Text["Idioma"]">
                <ActivatorContent>
                    <div class="language-trigger-btn" @onclick="context.ToggleAsync">
                        <span class="flag-icon">@((MarkupString)Text.CurrentCulture.FlagSvg)</span>
                        <span class="language-code">@Text.CurrentCulture.ShortName</span>
                        <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
                    </div>
                </ActivatorContent>
                <ChildContent>
                    @foreach (var culture in AppLocalizer.SupportedCultures)
                    {
                        var isCurrent = culture.Name == Text.CurrentCulture.Name;
                        <MudMenuItem OnClick="() => ChangeCultureAsync(culture.Name)" Class="@(isCurrent ? "selected-culture-item" : null)">
                            <div class="culture-item-row">
                                <span class="flag-icon">@((MarkupString)culture.FlagSvg)</span>
                                <span class="culture-label">@culture.DisplayName</span>
                                @if (isCurrent)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="current-check" />
                                }
                            </div>
                        </MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        </MudTooltip>
        <MudTooltip Text="Notificacoes" Placement="Placement.Bottom">
            <MudBadge Content="_unreadCount" Color="Color.Error" Overlap Bordered="false" Visible="@(_unreadCount > 0)">
                <MudIconButton Icon="@Icons.Material.Outlined.Notifications" Color="Color.Inherit" Href="/notifications" />
            </MudBadge>
        </MudTooltip>
        @if (Auth.CurrentUser is { } user)
        {
            <div class="profile-menu-container">
                @if (_profileMenuOpen)
                {
                    <div class="popover-backdrop" @onclick="CloseProfileMenu"></div>
                }
                <button type="button" class="profile-trigger-btn" @onclick="ToggleProfileMenu">
                    <div class="avatar-wrapper">
                        <span class="avatar avatar-small">@user.Initials</span>
                        <span class="online-dot"></span>
                    </div>
                    <span class="profile-trigger-copy">
                        <strong class="profile-name">@user.DisplayName</strong>
                        <small class="profile-email">@user.Email</small>
                    </span>
                </button>
            </div>
        }
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md"
               Elevation="3" Class="nav-drawer">
        <div class="drawer-inner">
            <a class="brand drawer-brand" href="/dashboard">
                <img src="logo.png" alt="Logo" class="sidebar-logo-img" />
            </a>
            <MudText Typo="Typo.overline" Class="nav-label" Color="Color.Primary">@Text["Workspace"]</MudText>
            <MudNavMenu Class="nav-menu">
                <MudNavLink Href="dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Analytics">@Text["Painel e relatorios"]</MudNavLink>
                <MudNavGroup Title="@Text["Financeiro"]" Icon="@Icons.Material.Filled.Payments" @bind-Expanded="FinanceExpanded">
                    <MudNavLink Href="dre" Icon="@Icons.Material.Filled.AccountBalance">DRE preliminar</MudNavLink>
                    <MudNavLink Href="expenses" Icon="@Icons.Material.Filled.ReceiptLong">Despesas</MudNavLink>
                    <MudNavLink Href="reconciliation" Icon="@Icons.Material.Filled.AccountBalanceWallet">@Text["Conciliacao financeira"]</MudNavLink>
                </MudNavGroup>
                <MudNavGroup Title="@Text["Operacao"]" Icon="@Icons.Material.Filled.Domain" @bind-Expanded="OperationExpanded">
                    <MudNavLink Href="inventory" Icon="@Icons.Material.Filled.Inventory2">Estoque e CMV</MudNavLink>
                    <MudNavLink Href="fiscal" Icon="@Icons.Material.Filled.Gavel">Fiscal e impostos</MudNavLink>
                    <MudNavLink Href="closing" Icon="@Icons.Material.Filled.LockClock">Fechamento mensal</MudNavLink>
                </MudNavGroup>
                <MudNavGroup Title="@Text["Integracoes"]" Icon="@Icons.Material.Filled.Extension" @bind-Expanded="IntegrationsExpanded">
                    <MudNavLink Href="connectors" Icon="@Icons.Material.Filled.Hub">@Text["Conectores"]</MudNavLink>
                    <MudNavLink Href="notifications" Icon="@Icons.Material.Filled.NotificationsNone">@Text["Notificacoes"]</MudNavLink>
                </MudNavGroup>
                <MudNavGroup Title="@Text["Conta"]" Icon="@Icons.Material.Filled.AdminPanelSettings" @bind-Expanded="AccountExpanded">
                    @if (Auth.CurrentUser?.Roles.Contains("Admin") == true)
                    {
                        <MudNavLink Href="users" Icon="@Icons.Material.Filled.ManageAccounts">Acessos da empresa</MudNavLink>
                    }
                    <MudNavLink Href="profile" Icon="@Icons.Material.Filled.PersonOutline">@Text["Meu perfil"]</MudNavLink>
                </MudNavGroup>
            </MudNavMenu>
            <MudSpacer />
            <div class="security-card">
                <MudIcon Icon="@Icons.Material.Filled.GppGood" />
                <div><strong>@Text["Tenant protegido"]</strong><small>@Text["Isolamento ativo"]</small></div>
            </div>
            <MudTooltip Text="Encerrar sessao e sair da conta" Placement="Placement.Right">
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Logout" FullWidth
                           Class="logout-button" OnClick="LogoutAsync">@Text["Sair da conta"]</MudButton>
            </MudTooltip>
        </div>
    </MudDrawer>

    <MudMainContent Class="main-content">
        @if (!_ready)
        {
            <div class="route-loader"><MudProgressCircular Indeterminate Color="Color.Primary" /><span>@Text["Preparando seu workspace..."]</span></div>
        }
        else
        {
            @ChildContent
        }
    </MudMainContent>
</MudLayout>

@code {
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string PageContext { get; set; } = "Workspace";
    private bool _drawerOpen = true;
    private bool _ready;
    private int _unreadCount;
    private bool _financeExpanded;
    private bool _operationExpanded;
    private bool _integrationsExpanded;
    private bool _accountExpanded;
    private bool FinanceExpanded { get => _financeExpanded; set => SetExpanded(NavSection.Finance, value); }
    private bool OperationExpanded { get => _operationExpanded; set => SetExpanded(NavSection.Operation, value); }
    private bool IntegrationsExpanded { get => _integrationsExpanded; set => SetExpanded(NavSection.Integrations, value); }
    private bool AccountExpanded { get => _accountExpanded; set => SetExpanded(NavSection.Account, value); }

    private static readonly MudTheme Theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#252525",
            Secondary = "#666666",
            Background = "#F3F3F2",
            Surface = "#FFFFFF",
            TextPrimary = "#181818",
            TextSecondary = "#666666",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#0F172A",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#181818",
            Success = "#3F3F3F",
            Warning = "#737373",
            Error = "#202020",
            Info = "#5A5A5A"
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "10px", DrawerWidthLeft = "285px" }
    };

    protected override async Task OnInitializedAsync()
    {
        Auth.SessionChanged += OnSessionChanged;
        ExpandForCurrentRoute();
        await Auth.InitializeAsync();
        if (!OperatingSystem.IsBrowser())
        {
            _ready = true;
            return;
        }
        if (!Auth.IsAuthenticated)
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
            return;
        }
        if (Auth.CurrentUser?.RequiresPasswordChange == true &&
            !Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("profile", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/profile");
            return;
        }
        var notifications = await Notifications.GetAsync(unreadOnly: true);
        if (notifications.Succeeded)
            _unreadCount = notifications.Value!.UnreadCount;
        _ready = true;
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void ExpandForCurrentRoute()
    {
        var route = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();
        var section = route switch
        {
            "dre" or "expenses" or "reconciliation" => NavSection.Finance,
            "inventory" or "fiscal" or "closing" => NavSection.Operation,
            "connectors" or "notifications" => NavSection.Integrations,
            "users" or "profile" => NavSection.Account,
            _ => NavSection.None
        };
        SetExpanded(section, section != NavSection.None);
    }

    private void SetExpanded(NavSection section, bool expanded)
    {
        if (!expanded)
        {
            if (section == NavSection.Finance) _financeExpanded = false;
            if (section == NavSection.Operation) _operationExpanded = false;
            if (section == NavSection.Integrations) _integrationsExpanded = false;
            if (section == NavSection.Account) _accountExpanded = false;
            return;
        }
        _financeExpanded = section == NavSection.Finance;
        _operationExpanded = section == NavSection.Operation;
        _integrationsExpanded = section == NavSection.Integrations;
        _accountExpanded = section == NavSection.Account;
    }
    private bool _profileMenuOpen;
    private void ToggleProfileMenu() => _profileMenuOpen = !_profileMenuOpen;
    private void CloseProfileMenu() => _profileMenuOpen = false;
    private void NavigateAndClose(string uri)
    {
        _profileMenuOpen = false;
        Navigation.NavigateTo(uri);
    }
    private async Task LogoutAndClose()
    {
        _profileMenuOpen = false;
        await LogoutAsync();
    }
    private void GoToProfile() => Navigation.NavigateTo("/profile");
    private async Task ChangeCultureAsync(string cultureName)
    {
        if (cultureName == Text.CurrentCulture.Name) return;
        await JavaScript.InvokeVoidAsync("localStorage.setItem", "nucleo.culture", cultureName);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/login", replace: true);
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Auth.SessionChanged -= OnSessionChanged;
    private enum NavSection { None, Finance, Operation, Integrations, Account }
}
