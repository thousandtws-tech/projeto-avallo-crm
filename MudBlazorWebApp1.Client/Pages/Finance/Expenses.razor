@page "/expenses"
@rendermode InteractiveWebAssembly
@using System.Globalization
@inject ExpenseService ExpensesService
@inject AuthService Auth
@inject AppLocalizer Text
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@Text["Despesas operacionais"] | Nucleo</PageTitle>

<AppShellLayout PageContext="@Text["Despesas operacionais"]">
<div class="page-container expenses-page">
    <header class="page-header">
        <div><MudText Typo="Typo.overline" Color="Color.Primary">@Text["Controle de saidas"]</MudText><MudText Typo="Typo.h3">@Text["Despesas operacionais"]</MudText><MudText Typo="Typo.body1">@Text["Comprovantes, revisao contabil e integracao automatica com a DRE."]</MudText></div>
        @if (CanWrite) { <MudTooltip Text="@Text["Cadastrar nova despesa operacional"]" Placement="Placement.Bottom"><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate">@Text["Nova despesa"]</MudButton></MudTooltip> }
    </header>

    <section class="expense-metrics">
        <article class="metric-card"><MudText Typo="Typo.caption">@Text["TOTAL CADASTRADO"]</MudText><MudText Typo="Typo.h4">@Money(_expenses.Sum(x => x.Amount))</MudText><MudText Typo="Typo.body2">@_expenses.Length @Text["lancamentos"]</MudText></article>
        <article class="metric-card"><MudText Typo="Typo.caption">@Text["EM REVISAO"]</MudText><MudText Typo="Typo.h4">@Money(_expenses.Where(x => x.Status == "PendingReview").Sum(x => x.Amount))</MudText><MudText Typo="Typo.body2">@Text["Aguardando contador"]</MudText></article>
        <article class="metric-card"><MudText Typo="Typo.caption">@Text["APROVADO NA DRE"]</MudText><MudText Typo="Typo.h4">@Money(_expenses.Where(x => x.Status == "Approved").Sum(x => x.Amount))</MudText><MudText Typo="Typo.body2">@Text["Com comprovante validado"]</MudText></article>
    </section>

    <section class="panel entries-panel expense-list-panel">
        <div class="entries-toolbar"><div><MudText Typo="Typo.h5">@Text["Lancamentos operacionais"]</MudText><MudText Typo="Typo.body2">@Text["Somente despesas aprovadas impactam o resultado contabil."]</MudText></div><MudTooltip Text="@Text["Recarregar lista de despesas"]" Placement="Placement.Left"><MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">@Text["Atualizar"]</MudButton></MudTooltip></div>
        @if (_loading)
        {
            <div class="mt-4">
                <MudSkeleton Width="100%" Height="40px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="30px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="30px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="30px" />
            </div>
        }
        else
        {
            <MudTable T="ExpenseModel" Items="_expenses" Hover Breakpoint="Breakpoint.Sm" Class="entries-table">
                <HeaderContent><MudTh>@Text["Competencia"]</MudTh><MudTh>@Text["Lancamento"]</MudTh><MudTh>@Text["Categoria"]</MudTh><MudTh>@Text["Comprovantes"]</MudTh><MudTh>@Text["Status"]</MudTh><MudTh Class="text-right">@Text["Valor"]</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate Context="expense">
                    <MudTd DataLabel="@Text["Competencia"]"><strong>@expense.CompetenceDate.ToString("d", CultureInfo.CurrentCulture)</strong></MudTd>
                    <MudTd DataLabel="@Text["Lancamento"]"><strong>@expense.Description</strong><small class="table-secondary">@(expense.Supplier ?? Text["Sem fornecedor"])</small>@if (!string.IsNullOrWhiteSpace(expense.RejectionReason)) { <small class="expense-rejection">@expense.RejectionReason</small> }</MudTd>
                    <MudTd DataLabel="@Text["Categoria"]"><span class="platform-pill">@CategoryLabel(expense.Category)</span></MudTd>
                    <MudTd DataLabel="@Text["Comprovantes"]">
                        <div class="attachment-list">
                            @foreach (var attachment in expense.Attachments) { <button title="@Text["Abrir comprovante"]" @onclick="() => DownloadAsync(expense, attachment)"><MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" /> @attachment.FileName</button> }
                            @if (CanWrite && CanEdit(expense))
                            {
                                <MudFileUpload T="IBrowserFile" OnFilesChanged="e => UploadAsync(expense, e)" Accept=".pdf,.png,.jpg,.jpeg">
                                    <CustomContent>
                                        <MudButton Variant="Variant.Text"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.UploadFile"
                                                   Size="Size.Small"
                                                   Class="pa-0"
                                                   OnClick="@context.OpenFilePickerAsync">
                                            @Text["Anexar"]
                                        </MudButton>
                                    </CustomContent>
                                </MudFileUpload>
                            }
                        </div>
                    </MudTd>
                    <MudTd DataLabel="@Text["Status"]"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@StatusColor(expense.Status)">@StatusLabel(expense.Status)</MudChip></MudTd>
                    <MudTd DataLabel="@Text["Valor"]" Class="text-right money-cell">@Money(expense.Amount)</MudTd>
                    <MudTd><div class="expense-actions">@if (CanWrite && CanEdit(expense)) { <MudTooltip Text="@Text["Enviar comprovante para revisao do contador"]" Placement="Placement.Top"><MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(expense.Attachments.Length == 0 || _busyId == expense.Id)" OnClick="() => SubmitAsync(expense)">@Text["Enviar para revisao"]</MudButton></MudTooltip> } @if (CanReview && expense.Status == "PendingReview") { <MudTooltip Text="@Text["Aprovar despesa e lançar na DRE"]" Placement="Placement.Top"><MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" aria-label="@Text["Aplicar"]" Disabled="@(_busyId == expense.Id)" OnClick="() => ApproveAsync(expense)" /></MudTooltip><MudTooltip Text="@Text["Rejeitar e devolver para correcao"]" Placement="Placement.Top"><MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" aria-label="@Text["Rejeitar despesa"]" OnClick="() => OpenReject(expense)" /></MudTooltip> }</div></MudTd>
                </RowTemplate>
                <NoRecordsContent><EmptyReport Icon="@Icons.Material.Outlined.ReceiptLong" Text="@Text["Nenhuma despesa operacional cadastrada."]" /></NoRecordsContent>
            </MudTable>
        }
    </section>

    @if (_creating)
    {
        <div class="connector-modal-backdrop" @onclick="CloseCreate"><article class="connector-modal panel expense-modal" @onclick:stopPropagation>
            <div class="panel-heading"><div><MudText Typo="Typo.h5">@Text["Nova despesa"]</MudText><MudText Typo="Typo.body2">@Text["Cadastre a competencia e anexe o comprovante depois de salvar."]</MudText></div><MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseCreate" /></div>
            <MudForm @ref="_form"><MudTextField @bind-Value="Form.Description" Label="@Text["Descricao"]" Variant="Variant.Outlined" Required Class="mb-3" /><div class="field-grid"><MudSelect T="string" @bind-Value="Form.Category" Label="@Text["Categoria"]" Variant="Variant.Outlined">@foreach (var category in Categories) { <MudSelectItem Value="@category">@CategoryLabel(category)</MudSelectItem> }</MudSelect><MudNumericField T="decimal" @bind-Value="Form.Amount" Label="@Text["Valor"]" Variant="Variant.Outlined" Min="0.01M" Format="C" Culture="CultureInfo.CurrentCulture" /></div><MudTextField @bind-Value="Form.Supplier" Label="@Text["Fornecedor"]" Variant="Variant.Outlined" Class="my-3" /><div class="field-grid"><MudDatePicker @bind-Date="Form.CompetenceDate" Label="@Text["Competencia"]" Variant="Variant.Outlined" Required /><MudDatePicker @bind-Date="Form.DueDate" Label="@Text["Vencimento"]" Variant="Variant.Outlined" Clearable /></div><MudTextField @bind-Value="Form.Notes" Label="@Text["Observacoes"]" Variant="Variant.Outlined" Lines="3" Class="my-3" /><MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth Disabled="_saving" OnClick="CreateAsync">@(_saving ? Text["Salvando..."] : Text["Salvar despesa"])</MudButton></MudForm>
        </article></div>
    }

    @if (_rejecting is not null)
    {
        <div class="connector-modal-backdrop" @onclick="CloseReject"><article class="connector-modal panel" @onclick:stopPropagation><div class="panel-heading"><div><MudText Typo="Typo.h5">@Text["Rejeitar despesa"]</MudText><MudText Typo="Typo.body2">@Text["Informe o motivo para o vendedor corrigir o lancamento."]</MudText></div><MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseReject" /></div><MudTextField @bind-Value="_rejectionReason" Label="@Text["Motivo da rejeicao"]" Variant="Variant.Outlined" Lines="3" Required Class="mb-3" /><MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth Disabled="@string.IsNullOrWhiteSpace(_rejectionReason)" OnClick="RejectAsync">@Text["Confirmar rejeicao"]</MudButton></article></div>
    }
</div>
</AppShellLayout>

@code {
    private static readonly string[] Categories = ["Payroll", "Rent", "Utilities", "Internet", "Software", "ProfessionalServices", "BankFees", "Other"];
    private ExpenseModel[] _expenses = [];
    private ExpenseFormModel Form = new();
    private MudForm? _form;
    private ExpenseModel? _rejecting;
    private string _rejectionReason = string.Empty;
    private Guid? _busyId;
    private bool _loading = true;
    private bool _creating;
    private bool _saving;
    private bool CanReview => Auth.CurrentUser?.Roles.Contains("Admin") == true;
    private bool CanWrite => Auth.CurrentUser?.Roles.Any(x => x is "Admin" or "Vendedor") == true;

    protected override Task OnInitializedAsync() =>
        OperatingSystem.IsBrowser() ? LoadAsync() : Task.CompletedTask;
    private async Task LoadAsync() { _loading = true; var result = await ExpensesService.GetAsync(); _loading = false; if (result.Succeeded) _expenses = result.Value!; else Snackbar.Add(result.Error!, Severity.Error); }
    private void OpenCreate() { Form = new ExpenseFormModel(); _creating = true; }
    private void CloseCreate() => _creating = false;
    private async Task CreateAsync() { await _form!.ValidateAsync(); if (!_form.IsValid || Form.CompetenceDate is null || Form.Amount <= 0) return; _saving = true; var request = new ExpenseRequestModel(Form.Description, Form.Category, Form.Supplier, DateOnly.FromDateTime(Form.CompetenceDate.Value), Form.DueDate is null ? null : DateOnly.FromDateTime(Form.DueDate.Value), Form.Amount, Form.Notes); var result = await ExpensesService.CreateAsync(request); _saving = false; if (!result.Succeeded) { Snackbar.Add(result.Error!, Severity.Error); return; } _creating = false; Snackbar.Add(Text["Despesa salva. Anexe o comprovante para enviar a revisao."], Severity.Success); await LoadAsync(); }
    private bool CanEdit(ExpenseModel expense) => expense.Status is "Draft" or "Rejected";
    private async Task UploadAsync(ExpenseModel expense, InputFileChangeEventArgs args) { _busyId = expense.Id; var result = await ExpensesService.UploadAsync(expense.Id, args.File); _busyId = null; Snackbar.Add(result.Succeeded ? Text["Comprovante armazenado com seguranca."] : result.Error!, result.Succeeded ? Severity.Success : Severity.Error); if (result.Succeeded) await LoadAsync(); }
    private async Task SubmitAsync(ExpenseModel expense) { _busyId = expense.Id; var result = await ExpensesService.SubmitAsync(expense.Id); _busyId = null; Snackbar.Add(result.Succeeded ? Text["Despesa enviada para revisao."] : result.Error!, result.Succeeded ? Severity.Success : Severity.Error); if (result.Succeeded) await LoadAsync(); }
    private async Task ApproveAsync(ExpenseModel expense) { _busyId = expense.Id; var result = await ExpensesService.ApproveAsync(expense.Id); _busyId = null; Snackbar.Add(result.Succeeded ? Text["Despesa aprovada e lancada na DRE."] : result.Error!, result.Succeeded ? Severity.Success : Severity.Error); if (result.Succeeded) await LoadAsync(); }
    private void OpenReject(ExpenseModel expense) { _rejecting = expense; _rejectionReason = string.Empty; }
    private void CloseReject() => _rejecting = null;
    private async Task RejectAsync() { if (_rejecting is null) return; var result = await ExpensesService.RejectAsync(_rejecting.Id, _rejectionReason); Snackbar.Add(result.Succeeded ? Text["Despesa devolvida para correcao."] : result.Error!, result.Succeeded ? Severity.Success : Severity.Error); if (result.Succeeded) { _rejecting = null; await LoadAsync(); } }
    private async Task DownloadAsync(ExpenseModel expense, ExpenseAttachmentModel attachment) { var result = await ExpensesService.GetDownloadAsync(expense.Id, attachment.Id); if (result.Succeeded) Navigation.NavigateTo(result.Value!.Url, forceLoad: true); else Snackbar.Add(result.Error!, Severity.Error); }
    private static string Money(decimal value) => value.ToString("C", CultureInfo.CurrentCulture);
    private string CategoryLabel(string category) => category switch { "Payroll" => Text["Folha de pagamento"], "Rent" => Text["Aluguel"], "Utilities" => Text["Energia e utilidades"], "Internet" => Text["Internet e telefonia"], "Software" => Text["Software e assinaturas"], "ProfessionalServices" => Text["Servicos profissionais"], "BankFees" => Text["Despesas bancarias"], _ => Text["Outras despesas"] };
    private string StatusLabel(string status) => status switch { "Draft" => Text["Rascunho"], "PendingReview" => Text["Em revisao"], "Approved" => Text["Aprovada"], "Rejected" => Text["Rejeitada"], _ => status };
    private static Color StatusColor(string status) => status switch { "Approved" => Color.Success, "PendingReview" => Color.Warning, "Rejected" => Color.Error, _ => Color.Default };
}
