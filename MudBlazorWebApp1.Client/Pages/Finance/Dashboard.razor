@page "/dashboard"
@rendermode InteractiveWebAssembly
@using System.Globalization
@inject AuthService Auth
@inject ReportService Reports
@inject ConnectorService Connectors
@inject AppLocalizer Text
@inject ISnackbar Snackbar
@inject IJSRuntime JavaScript

<PageTitle>Painel e relatorios | Nucleo</PageTitle>

<AppShellLayout PageContext="Painel e relatorios">
<div class="page-container report-page">
    <header class="page-header report-header">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">@Text["Visao consolidada"]</MudText>
            <MudText Typo="Typo.h3">@Text["Painel financeiro"]</MudText>
            <MudText Typo="Typo.body1">@Text["Todos os marketplaces conectados em uma unica leitura."]</MudText>
        </div>
        <MudTooltip Text="Exportar dados financeiros em varios formatos" Placement="Placement.Bottom">
            <MudMenu Label="@(_exporting ? "Gerando arquivo..." : "Exportar relatorio")" Variant="Variant.Outlined"
                     StartIcon="@Icons.Material.Outlined.FileDownload" EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                     Disabled="_exporting" Class="export-menu">
                <MudMenuItem Icon="@Icons.Material.Filled.PictureAsPdf" OnClick="ExportPdfAsync">PDF para contador</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.TableView" OnClick="ExportExcelAsync">Excel por marketplace</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.DataObject" OnClick="ExportCsvAsync">CSV para integracao</MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.AccountTree" OnClick="ExportPlatformPdfAsync">PDF separado por plataforma</MudMenuItem>
            </MudMenu>
        </MudTooltip>
    </header>

    <section class="filter-panel panel">
        <div class="filter-title"><MudIcon Icon="@Icons.Material.Filled.Tune" /><div><strong>@Text["Filtros"]</strong><small>@Text["Refine os indicadores e lancamentos"]</small></div></div>
        <div class="filter-grid">
            <MudDateRangePicker @bind-DateRange="Period" Label="@Text["Periodo"]" Variant="Variant.Outlined"
                                DateFormat="dd/MM/yyyy" Clearable Margin="Margin.Dense" />
            <MudSelect T="string" @bind-Value="Filter.Platform" Label="@Text["Conector"]" Variant="Variant.Outlined" Clearable Margin="Margin.Dense">
                @foreach (var connectorName in ActiveConnectorNames) { <MudSelectItem Value="@connectorName">@ConnectorDisplayName(connectorName)</MudSelectItem> }
            </MudSelect>
            <MudSelect T="string" @bind-Value="Filter.PaymentMethod" Label="@Text["Forma de pagamento"]" Variant="Variant.Outlined" Clearable Margin="Margin.Dense">
                @foreach (var option in Options.PaymentMethods) { <MudSelectItem Value="@option">@option</MudSelectItem> }
            </MudSelect>
            <MudSelect T="string" @bind-Value="Filter.Status" Label="@Text["Status"]" Variant="Variant.Outlined" Clearable Margin="Margin.Dense">
                @foreach (var option in Options.Statuses) { <MudSelectItem Value="@option">@option</MudSelectItem> }
            </MudSelect>
            <MudTooltip Text="Filtrar indicadores pelo periodo e conector selecionados" Placement="Placement.Bottom">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterAlt"
                           Disabled="_loading" OnClick="ApplyFiltersAsync">@Text["Aplicar"]</MudButton>
            </MudTooltip>
        </div>
    </section>

    <section class="panel online-connectors-panel">
        <div class="online-connectors-heading">
            <div>
                <div class="online-connectors-title">
                    <MudText Typo="Typo.h5">@Text["Conectores em operacao"]</MudText>
                    <span class="live-indicator"><i></i> @Text["Ao vivo"]</span>
                </div>
                <MudText Typo="Typo.body2">@Text["Conexoes online que alimentam os indicadores financeiros."]</MudText>
            </div>
            <div class="online-connectors-total">
                <strong>@ActiveConnections.Length</strong>
                <span>@Text[ActiveConnections.Length == 1 ? "conector ativo" : "conectores ativos"]</span>
            </div>
        </div>

        @if (_loadingConnectors)
        {
            <div class="mt-4">
                <MudSkeleton Width="100%" Height="40px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="30px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="30px" />
            </div>
        }
        else if (ActiveConnections.Length == 0)
        {
            <div class="online-connectors-empty">
                <MudIcon Icon="@Icons.Material.Outlined.CloudOff" />
                <div><strong>@Text["Nenhum conector online"]</strong><small>@Text["Ative uma conexao para acompanhar a operacao neste painel."]</small></div>
            </div>
        }
        else
        {
            <MudTable T="MarketplaceConnectionModel" Items="ActiveConnections" Dense Hover Breakpoint="Breakpoint.Sm" Class="online-connectors-table">
                <HeaderContent>
                    <MudTh>@Text["Conector"]</MudTh>
                    <MudTh>@Text["Conta em operacao"]</MudTh>
                    <MudTh>@Text["Ultima sincronizacao"]</MudTh>
                    <MudTh>@Text["Acesso valido ate"]</MudTh>
                    <MudTh>@Text["Status"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Conector">
                        <div class="online-connector-name"><span>@if (IsMercadoLivre(context.ConnectorName)) { <img src="@MercadoLivreLogo" alt="Mercado Livre" /> } else { @Initials(ConnectorDisplayName(context.ConnectorName)) }</span><div><strong>@ConnectorDisplayName(context.ConnectorName)</strong><small>@context.ConnectorName</small></div></div>
                    </MudTd>
                    <MudTd DataLabel="Conta em operacao"><strong>@(context.AccountDisplayName ?? context.ExternalAccountId)</strong><small class="table-secondary">ID @context.ExternalAccountId</small></MudTd>
                    <MudTd DataLabel="Ultima sincronizacao"><strong>@LastSync(context)</strong><small class="table-secondary">@SyncHealth(context)</small></MudTd>
                    <MudTd DataLabel="Acesso valido ate"><strong>@context.TokenExpiresAt.ToLocalTime().ToString("dd/MM/yyyy")</strong><small class="table-secondary">@context.TokenExpiresAt.ToLocalTime().ToString("HH:mm")</small></MudTd>
                    <MudTd DataLabel="Status"><span class="online-status"><i></i> @Text["Online"]</span></MudTd>
                </RowTemplate>
            </MudTable>
        }
    </section>

    <section class="finance-card-grid">
        @if (_loading)
        {
            @for (int i = 0; i < 4; i++)
            {
                <article class="finance-card">
                    <MudSkeleton SkeletonType="SkeletonType.Circle" Width="40px" Height="40px" Class="mr-3" />
                    <div style="flex-grow: 1;">
                        <MudSkeleton Width="60px" Height="15px" Class="mb-2" />
                        <MudSkeleton Width="120px" Height="28px" Class="mb-1" />
                        <MudSkeleton Width="80px" Height="15px" />
                    </div>
                </article>
            }
        }
        else
        {
            <MudTooltip Text="Valor total das vendas no periodo selecionado" Placement="Placement.Top">
                <article class="finance-card"><span class="finance-card-icon billed"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" /></span><div><MudText Typo="Typo.caption">@Text["FATURADO"]</MudText><MudText Typo="Typo.h4">@Money(Data.Summary.Billed)</MudText><small>@Text["Vendas no periodo"]</small></div></article>
            </MudTooltip>
            <MudTooltip Text="Valores ja liquidados e creditados na conta" Placement="Placement.Top">
                <article class="finance-card"><span class="finance-card-icon received"><MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" /></span><div><MudText Typo="Typo.caption">@Text["RECEBIDO"]</MudText><MudText Typo="Typo.h4">@Money(Data.Summary.Received)</MudText><small>@Text["Valores liquidados"]</small></div></article>
            </MudTooltip>
            <MudTooltip Text="Custos cobrados pelos canais de venda" Placement="Placement.Top">
                <article class="finance-card"><span class="finance-card-icon fees"><MudIcon Icon="@Icons.Material.Filled.Percent" /></span><div><MudText Typo="Typo.caption">@Text["TAXAS"]</MudText><MudText Typo="Typo.h4">@Money(Data.Summary.Fees)</MudText><small>@Text["Custos dos canais"]</small></div></article>
            </MudTooltip>
            <MudTooltip Text="Saldo estimado a ser creditado" Placement="Placement.Top">
                <article class="finance-card"><span class="finance-card-icon receivable"><MudIcon Icon="@Icons.Material.Filled.Schedule" /></span><div><MudText Typo="Typo.caption">@Text["A RECEBER"]</MudText><MudText Typo="Typo.h4">@Money(Data.Summary.Receivable)</MudText><small>@Text["Saldo futuro estimado"]</small></div></article>
            </MudTooltip>
        }
    </section>

    <section class="report-chart-grid">
        <article class="panel chart-panel">
            <div class="panel-heading"><div><MudText Typo="Typo.h5">@Text["Evolucao mensal"]</MudText><MudText Typo="Typo.body2">Faturamento e recebimentos ao longo do tempo.</MudText></div><span class="legend-note">Mensal</span></div>
            @if (_loading)
            {
                <div class="d-flex align-end justify-space-between px-6 pt-10" style="height: 280px; width: 100%;">
                    <MudSkeleton Width="25px" Height="120px" />
                    <MudSkeleton Width="25px" Height="180px" />
                    <MudSkeleton Width="25px" Height="140px" />
                    <MudSkeleton Width="25px" Height="220px" />
                    <MudSkeleton Width="25px" Height="90px" />
                    <MudSkeleton Width="25px" Height="160px" />
                    <MudSkeleton Width="25px" Height="200px" />
                </div>
            }
            else if (Data.MonthlyEvolution.Length == 0)
            {
                <EmptyReport Icon="@Icons.Material.Outlined.ShowChart" Text="Ainda nao ha dados no periodo selecionado." />
            }
            else
            {
                <MudChart ChartType="ChartType.Line" ChartSeries="MonthlySeries" ChartLabels="MonthlyLabels" Height="280px" Width="100%" />
            }
        </article>
        <article class="panel chart-panel">
            <div class="panel-heading"><div><MudText Typo="Typo.h5">@Text["Comparativo por plataforma"]</MudText><MudText Typo="Typo.body2">Performance consolidada de cada canal.</MudText></div></div>
            @if (_loading)
            {
                <div class="d-flex align-end justify-space-between px-6 pt-10" style="height: 280px; width: 100%;">
                    <MudSkeleton Width="40px" Height="150px" />
                    <MudSkeleton Width="40px" Height="220px" />
                    <MudSkeleton Width="40px" Height="100px" />
                </div>
            }
            else if (Data.PlatformComparison.Length == 0)
            {
                <EmptyReport Icon="@Icons.Material.Outlined.BarChart" Text="Conecte marketplaces para visualizar a comparacao." />
            }
            else
            {
                <MudChart ChartType="ChartType.Bar" ChartSeries="PlatformSeries" ChartLabels="PlatformLabels" Height="280px" Width="100%" />
            }
        </article>
    </section>

    <section class="panel entries-panel">
        <div class="entries-toolbar">
            <div><MudText Typo="Typo.h5">@Text["Lancamentos"]</MudText><MudText Typo="Typo.body2">@Text["Movimentacoes financeiras de todos os canais."]</MudText></div>
            <MudTextField @bind-Value="Filter.Search" Placeholder="@Text["Buscar descricao ou ID..."]" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate DebounceInterval="450" OnDebounceIntervalElapsed="SearchAsync" Class="entry-search" />
        </div>
        <MudTable T="EntryModel" @ref="_table" ServerData="LoadEntriesAsync" Dense Hover Striped="false"
                  Breakpoint="Breakpoint.Sm" HorizontalScrollbar Loading="_loadingEntries" Class="entries-table">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="date" T="EntryModel">@Text["Data"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="description" T="EntryModel">@Text["Lancamento"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="platform" T="EntryModel">@Text["Plataforma"]</MudTableSortLabel></MudTh>
                <MudTh>@Text["Pagamento"]</MudTh>
                <MudTh><MudTableSortLabel SortLabel="status" T="EntryModel">@Text["Status"]</MudTableSortLabel></MudTh>
                <MudTh Class="text-right"><MudTableSortLabel SortLabel="amount" T="EntryModel">Faturado</MudTableSortLabel></MudTh>
                <MudTh Class="text-right">Taxas</MudTh>
                <MudTh Class="text-right">A receber</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Data"><strong>@context.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy")</strong><small class="table-secondary">@context.OccurredAt.ToLocalTime().ToString("HH:mm")</small></MudTd>
                <MudTd DataLabel="Lancamento"><strong>@context.Description</strong><small class="table-secondary">#@context.ExternalId</small></MudTd>
                <MudTd DataLabel="Plataforma"><span class="platform-pill">@context.Marketplace</span></MudTd>
                <MudTd DataLabel="Pagamento">@context.PaymentMethod</MudTd>
                <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@StatusColor(context.Status)">@context.Status</MudChip></MudTd>
                <MudTd DataLabel="Faturado" Class="text-right money-cell">@Money(context.GrossAmount)</MudTd>
                <MudTd DataLabel="Taxas" Class="text-right fee-cell">@Money(context.FeeAmount)</MudTd>
                <MudTd DataLabel="A receber" Class="text-right money-cell">@Money(context.ReceivableAmount)</MudTd>
            </RowTemplate>
            <NoRecordsContent><EmptyReport Icon="@Icons.Material.Outlined.ReceiptLong" Text="Nenhum lancamento encontrado para os filtros aplicados." Compact /></NoRecordsContent>
            <LoadingContent><MudText Class="pa-6">@Text["Carregando lancamentos..."]</MudText></LoadingContent>
            <PagerContent><MudTablePager PageSizeOptions="PageSizes" RowsPerPageString="Linhas por pagina" InfoFormat="{first_item}-{last_item} de {all_items}" /></PagerContent>
        </MudTable>
    </section>
</div>
</AppShellLayout>

@code {
    private static readonly int[] PageSizes = [10, 25, 50];
    private readonly ReportFilterModel Filter = new();
    private ReportOptionsModel Options = new([], [], []);
    private DashboardReportModel Data = EmptyData;
    private ConnectorDescriptorModel[] _availableConnectors = [];
    private MarketplaceConnectionModel[] _connections = [];
    private MudTable<EntryModel>? _table;
    private bool _loading = true;
    private bool _loadingConnectors = true;
    private bool _loadingEntries;
    private bool _exporting;
    private const string MercadoLivreLogo = "https://res.cloudinary.com/lz9vero5/image/upload/v1784441482/191761039894-Mercado-Libre-removebg-preview_wzz6x3.png";

    private static DashboardReportModel EmptyData => new(new ReportSummaryModel(0, 0, 0, 0), [], []);
    private DateRange Period
    {
        get => new(Filter.From, Filter.To);
        set { Filter.From = value.Start; Filter.To = value.End; }
    }

    private List<ChartSeries<double>> MonthlySeries =>
    [
        new() { Name = "Faturado", Data = Data.MonthlyEvolution.Select(x => (double)x.Billed).ToArray() },
        new() { Name = "Recebido", Data = Data.MonthlyEvolution.Select(x => (double)x.Received).ToArray() }
    ];
    private string[] MonthlyLabels => Data.MonthlyEvolution.Select(x =>
        DateTime.TryParseExact(x.Month, "yyyy-MM", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)
            ? date.ToString("MMM/yy", CultureInfo.CurrentCulture) : x.Month).ToArray();
    private List<ChartSeries<double>> PlatformSeries =>
    [
        new() { Name = "Faturado", Data = Data.PlatformComparison.Select(x => (double)x.Billed).ToArray() },
        new() { Name = "Recebido", Data = Data.PlatformComparison.Select(x => (double)x.Received).ToArray() }
    ];
    private string[] PlatformLabels => Data.PlatformComparison.Select(x => x.Platform).ToArray();
    private MarketplaceConnectionModel[] ActiveConnections => _connections
        .Where(x => string.Equals(x.Status, "Active", StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => ConnectorDisplayName(x.ConnectorName))
        .ThenBy(x => x.AccountDisplayName ?? x.ExternalAccountId)
        .ToArray();
    private string[] ActiveConnectorNames => ActiveConnections
        .Select(x => x.ConnectorName)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(ConnectorDisplayName)
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        if (!OperatingSystem.IsBrowser())
            return;
        var optionsTask = Reports.GetOptionsAsync();
        var connectorsTask = LoadConnectorsAsync();
        var dashboardTask = LoadDashboardAsync();
        var options = await optionsTask;
        if (options.Succeeded) Options = options.Value!;
        await Task.WhenAll(connectorsTask, dashboardTask);
    }

    private async Task LoadConnectorsAsync()
    {
        _loadingConnectors = true;
        var availableTask = Connectors.GetAvailableAsync();
        var connectionsTask = Connectors.GetConnectionsAsync();
        await Task.WhenAll(availableTask, connectionsTask);
        var available = await availableTask;
        var connections = await connectionsTask;
        if (available.Succeeded) _availableConnectors = available.Value!;
        if (connections.Succeeded) _connections = connections.Value!;
        else Snackbar.Add(connections.Error!, Severity.Error);
        _loadingConnectors = false;
    }

    private async Task ApplyFiltersAsync()
    {
        Filter.From = Period.Start;
        Filter.To = Period.End;
        await LoadDashboardAsync();
        if (_table is not null) await _table.ReloadServerData();
    }

    private async Task LoadDashboardAsync()
    {
        _loading = true;
        var result = await Reports.GetDashboardAsync(Filter);
        _loading = false;
        if (result.Succeeded) Data = result.Value!;
        else { Data = EmptyData; Snackbar.Add(result.Error!, Severity.Error); }
    }

    private async Task<TableData<EntryModel>> LoadEntriesAsync(TableState state, CancellationToken cancellationToken)
    {
        _loadingEntries = true;
        var sortBy = string.IsNullOrWhiteSpace(state.SortLabel) ? "date" : state.SortLabel;
        var result = await Reports.GetEntriesAsync(Filter, state.Page + 1, state.PageSize, sortBy,
            state.SortDirection == SortDirection.Descending, cancellationToken);
        _loadingEntries = false;
        if (result.Succeeded)
            return new TableData<EntryModel> { Items = result.Value!.Items, TotalItems = result.Value.Total };
        Snackbar.Add(result.Error!, Severity.Error);
        return new TableData<EntryModel> { Items = [], TotalItems = 0 };
    }

    private async Task SearchAsync(string _) { if (_table is not null) await _table.ReloadServerData(); }
    private Task ExportPdfAsync() => ExportAsync("pdf", "consolidated");
    private Task ExportExcelAsync() => ExportAsync("xlsx", "platform");
    private Task ExportCsvAsync() => ExportAsync("csv", "consolidated");
    private Task ExportPlatformPdfAsync() => ExportAsync("pdf", "platform");

    private async Task ExportAsync(string format, string mode)
    {
        _exporting = true;
        var result = await Reports.ExportAsync(Filter, format, mode);
        _exporting = false;
        if (!result.Succeeded)
        {
            Snackbar.Add(result.Error!, Severity.Error);
            return;
        }

        var file = result.Value!;
        await JavaScript.InvokeVoidAsync(
            "nucleo.downloadFile",
            file.FileName,
            file.ContentType,
            Convert.ToBase64String(file.Content));
        Snackbar.Add("Relatorio gerado com sucesso.", Severity.Success);
    }

    private static string Money(decimal value) => value.ToString("C", CultureInfo.CurrentCulture);
    private string ConnectorDisplayName(string connectorName) =>
        _availableConnectors.FirstOrDefault(x => string.Equals(x.Name, connectorName, StringComparison.OrdinalIgnoreCase))?.DisplayName
        ?? connectorName;
    private static string Initials(string value) => string.Concat(value.Split(['-', ' ', '_'], StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
    private static bool IsMercadoLivre(string connectorName) => connectorName.Contains("mercado", StringComparison.OrdinalIgnoreCase);
    private static string LastSync(MarketplaceConnectionModel connection) =>
        connection.LastSyncAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Ainda nao realizada";
    private static string SyncHealth(MarketplaceConnectionModel connection)
    {
        if (connection.LastSyncAt is null) return "Aguardando primeira carga";
        var elapsed = DateTimeOffset.UtcNow - connection.LastSyncAt.Value;
        return elapsed.TotalMinutes < 60 ? "Sincronizacao recente" : $"Ha {Math.Max(1, (int)elapsed.TotalHours)}h";
    }
    private static Color StatusColor(string status) => status.ToLowerInvariant() switch
    {
        "recebido" or "pago" or "aprovado" => Color.Success,
        "pendente" or "a receber" => Color.Warning,
        "cancelado" or "estornado" => Color.Error,
        _ => Color.Default
    };
}
