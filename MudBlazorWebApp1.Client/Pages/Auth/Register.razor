@page "/register"
@layout AuthLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: true))
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Criar workspace | Nucleo</PageTitle>

<div class="form-heading compact">
    <MudText Typo="Typo.overline" Color="Color.Primary">Comece agora</MudText>
    <MudText Typo="Typo.h3">Crie seu workspace</MudText>
    <MudText Typo="Typo.body1">Sua empresa ganha um ambiente exclusivo desde o primeiro acesso.</MudText>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense Class="mb-4">@_error</MudAlert>
}

<MudForm @ref="_form" Model="Model">
    <div class="field-grid">
        <MudTextField @bind-Value="Model.DisplayName" For="@(() => Model.DisplayName)" Label="Seu nome"
                      Variant="Variant.Outlined" />
        <MudTextField @bind-Value="Model.TenantName" For="@(() => Model.TenantName)" Label="Empresa"
                      Variant="Variant.Outlined" />
    </div>
    <MudTextField @bind-Value="Model.Email" For="@(() => Model.Email)" Label="E-mail profissional"
                  Variant="Variant.Outlined" InputType="InputType.Email" Class="mt-3 mb-3" />
    <MudTextField @bind-Value="Model.Password" For="@(() => Model.Password)" Label="Crie uma senha"
                  HelperText="Minimo de 12 caracteres, com maiuscula, numero e simbolo."
                  Variant="Variant.Outlined" InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                  Adornment="Adornment.End" AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                  OnAdornmentClick="TogglePassword" />
    <MudCheckBox T="bool" @bind-Value="_accepted" Class="terms-check"
                 Label="Concordo com os termos de uso e a politica de privacidade." />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth Size="Size.Large" Class="primary-cta"
               Disabled="@(_busy || !_accepted)" OnClick="SubmitAsync">
        @if (_busy) { <MudProgressCircular Indeterminate Size="Size.Small" Class="mr-2" /> }
        Criar workspace seguro
    </MudButton>
</MudForm>

<div class="divider"><span>ou cadastre com</span></div>
<MudButton Variant="Variant.Outlined" FullWidth Size="Size.Large" StartIcon="@Icons.Custom.Brands.Google"
           Disabled="_busy" OnClick="RegisterWithGoogle">Google Workspace</MudButton>
<MudText Align="Align.Center" Class="form-footer">Ja possui uma conta? <MudLink Href="/login">Entrar</MudLink></MudText>

@code {
    private readonly RegisterModel Model = new();
    private MudForm? _form;
    private bool _showPassword;
    private bool _accepted;
    private bool _busy;
    private string? _error;

    private void TogglePassword() => _showPassword = !_showPassword;
    private void RegisterWithGoogle() => Navigation.NavigateTo(Auth.GetGoogleLoginUrl(Model.TenantName), forceLoad: true);

    private async Task SubmitAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid || !_accepted) return;
        _busy = true;
        _error = null;
        var result = await Auth.RegisterAsync(Model);
        _busy = false;
        if (result.Succeeded)
            Navigation.NavigateTo("/dashboard", replace: true);
        else
            _error = result.Error;
    }
}
