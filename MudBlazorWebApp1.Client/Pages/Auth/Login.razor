@page "/login"
@layout AuthLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: true))
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Entrar | Nucleo</PageTitle>

<div class="form-heading">
    <MudText Typo="Typo.overline" Color="Color.Primary">Bem-vindo de volta</MudText>
    <MudText Typo="Typo.h3">Entre no seu workspace</MudText>
    <MudText Typo="Typo.body1">Acompanhe sua operacao e mantenha a equipe alinhada.</MudText>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense Class="mb-5">@_error</MudAlert>
}

<MudForm @ref="_form" Model="Model">
    <MudTextField @bind-Value="Model.Email" For="@(() => Model.Email)" Label="E-mail profissional"
                  Variant="Variant.Outlined" InputType="InputType.Email" Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Outlined.Email" Class="mb-3" />
    <MudTextField @bind-Value="Model.Password" For="@(() => Model.Password)" Label="Senha"
                  Variant="Variant.Outlined" InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                  Adornment="Adornment.End" AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                  OnAdornmentClick="TogglePassword" />
    <div class="form-assist"><MudCheckBox T="bool" @bind-Value="_remember" Label="Manter conectado" /><MudLink Href="#">Esqueci minha senha</MudLink></div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth Size="Size.Large" Class="primary-cta"
               Disabled="_busy" OnClick="SubmitAsync">
        @if (_busy) { <MudProgressCircular Indeterminate Size="Size.Small" Class="mr-2" /> }
        Entrar no workspace
    </MudButton>
</MudForm>

<div class="divider"><span>ou continue com</span></div>
<MudButton Variant="Variant.Outlined" FullWidth Size="Size.Large" StartIcon="@Icons.Custom.Brands.Google"
           Class="google-button" OnClick="LoginWithGoogle">Google Workspace</MudButton>

<MudText Align="Align.Center" Class="form-footer">Ainda nao tem uma conta? <MudLink Href="/register">Criar workspace</MudLink></MudText>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    private readonly LoginModel Model = new();
    private MudForm? _form;
    private bool _showPassword;
    private bool _remember = true;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Error))
            _error = Error;
        if (!OperatingSystem.IsBrowser())
            return;
        await Auth.InitializeAsync();
        if (Auth.IsAuthenticated)
            Navigation.NavigateTo("/dashboard", replace: true);
    }

    private void TogglePassword() => _showPassword = !_showPassword;
    private void LoginWithGoogle() => Navigation.NavigateTo(Auth.GetGoogleLoginUrl("Meu workspace"), forceLoad: true);

    private async Task SubmitAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid) return;
        _busy = true;
        _error = null;
        var result = await Auth.LoginAsync(Model);
        _busy = false;
        if (result.Succeeded)
            Navigation.NavigateTo(SafeReturnUrl(), replace: true);
        else
            _error = result.Error;
    }

    private string SafeReturnUrl() => !string.IsNullOrWhiteSpace(ReturnUrl) && !ReturnUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase)
        ? $"/{ReturnUrl.TrimStart('/')}"
        : "/dashboard";
}
