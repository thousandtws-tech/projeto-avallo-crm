@page "/connectors"
@rendermode InteractiveWebAssembly
@inject ConnectorService ConnectorsService
@inject AuthService Auth
@inject AppLocalizer Text
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@Text["Conectores"] | Nucleo</PageTitle>

<AppShellLayout PageContext="@Text["Conectores"]">
<div class="page-container connectors-page">
    <header class="page-header">
        <div><MudText Typo="Typo.overline" Color="Color.Primary">@Text["Camada modular"]</MudText><MudText Typo="Typo.h3">@Text["Marketplaces conectados"]</MudText></div>
        <div class="connector-contract-badge"><MudIcon Icon="@Icons.Material.Filled.Extension" /><span>@Text["Contrato"]</span></div>
    </header>

    @if (_loading)
    {
        <div class="page-container connectors-page">
            <header class="page-header">
                <div>
                    <MudSkeleton Width="120px" Height="20px" Class="mb-2" />
                    <MudSkeleton Width="300px" Height="40px" />
                </div>
            </header>

            <section class="connector-section mt-6">
                <MudSkeleton Width="150px" Height="24px" Class="mb-4" />
                <div class="connection-grid">
                    <article class="panel connection-card">
                        <div class="d-flex align-center mb-4">
                            <MudSkeleton SkeletonType="SkeletonType.Circle" Width="48px" Height="48px" Class="mr-3" />
                            <div>
                                <MudSkeleton Width="150px" Height="20px" Class="mb-1" />
                                <MudSkeleton Width="100px" Height="15px" />
                            </div>
                        </div>
                        <MudSkeleton Width="100%" Height="15px" Class="mb-2" />
                        <MudSkeleton Width="80%" Height="15px" Class="mb-4" />
                        <MudSkeleton Width="100%" Height="36px" />
                    </article>
                    <article class="panel connection-card">
                        <div class="d-flex align-center mb-4">
                            <MudSkeleton SkeletonType="SkeletonType.Circle" Width="48px" Height="48px" Class="mr-3" />
                            <div>
                                <MudSkeleton Width="150px" Height="20px" Class="mb-1" />
                                <MudSkeleton Width="100px" Height="15px" />
                            </div>
                        </div>
                        <MudSkeleton Width="100%" Height="15px" Class="mb-2" />
                        <MudSkeleton Width="80%" Height="15px" Class="mb-4" />
                        <MudSkeleton Width="100%" Height="36px" />
                    </article>
                </div>
            </section>
        </div>
    }
    else
    {
        <section class="connector-section">
            <div class="section-heading"><div><MudText Typo="Typo.h5">@Text["Contas conectadas"]</MudText><MudText Typo="Typo.body2">@Text["Status, validade do token e ultima sincronizacao."]</MudText></div></div>
            @if (_connections.Length == 0)
            {
                <div class="panel connector-empty"><span><MudIcon Icon="@Icons.Material.Outlined.LinkOff" /></span><MudText Typo="Typo.h6">@Text["Nenhuma conta conectada"]</MudText><MudText Typo="Typo.body2">@Text["Escolha um modulo instalado abaixo para iniciar."]</MudText></div>
            }
            else
            {
                <div class="connection-grid">
                    @foreach (var connection in _connections)
                    {
                        <article class="panel connection-card">
                            <div class="connection-logo">@if (IsMercadoLivre(connection.ConnectorName)) { <img src="@MercadoLivreLogo" alt="Mercado Livre" /> } else { @Initials(connection.ConnectorName) }</div>
                            <div class="connection-main"><div><strong>@(connection.AccountDisplayName ?? connection.ExternalAccountId)</strong><small>@connection.ConnectorName</small></div><MudChip T="string" Size="Size.Small" Color="@StatusColor(connection.Status)">@connection.Status</MudChip></div>
                            <div class="connection-meta"><span><small>@Text["Ultima sincronizacao"]</small><strong>@(connection.LastSyncAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? Text["Nunca"])</strong></span><span><small>@Text["Token valido ate"]</small><strong>@connection.TokenExpiresAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></span></div>
                            @if (CanWrite) { <MudTooltip Text="@Text["Buscar dados atualizados do marketplace"]" Placement="Placement.Bottom"><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync" Disabled="@(_syncingId == connection.Id)" OnClick="() => SyncAsync(connection)">@(_syncingId == connection.Id ? Text["Sincronizando..."] : Text["Sincronizar agora"])</MudButton></MudTooltip> }
                        </article>
                    }
                </div>
            }
        </section>

        <section class="connector-section">
            <div class="section-heading"><div><MudText Typo="Typo.h5">@Text["Modulos instalados"]</MudText><MudText Typo="Typo.body2">@Text["Plugins descobertos no startup pelo contrato padronizado."]</MudText></div><MudChip T="string" Size="Size.Small">@_available.Length @Text["disponiveis"]</MudChip></div>
            @if (_available.Length == 0)
            {
                <div class="panel module-empty"><span class="metric-icon"><MudIcon Icon="@Icons.Material.Filled.ExtensionOff" /></span><div><strong>@Text["Nenhum plugin instalado"]</strong><small>@Text["Publique o DLL de um modulo na pasta configurada em Connectors:PluginPath. O Core permanece inalterado."]</small></div></div>
            }
            else
            {
                <div class="module-grid">
                    @foreach (var connector in _available)
                    {
                        <article class="panel module-card"><div class="connection-logo muted">@if (IsMercadoLivre(connector.Name)) { <img src="@MercadoLivreLogo" alt="Mercado Livre" /> } else { @Initials(connector.Name) }</div><div><MudText Typo="Typo.h6">@connector.DisplayName</MudText><MudText Typo="Typo.body2">@connector.Name &middot; v@connector.Version @if (connector.UsesOAuth) { <span>&middot; OAuth 2.0</span> }</MudText></div><MudSpacer />@if (CanWrite) { <MudTooltip Text="@Text["Iniciar conexao com o marketplace"]" Placement="Placement.Bottom"><MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_oauthConnector == connector.Name)" OnClick="() => ConnectAsync(connector)">@(_oauthConnector == connector.Name ? Text["Redirecionando..."] : Text["Conectar"])</MudButton></MudTooltip> }</article>
                    }
                </div>
            }
        </section>

        @if (_selected is not null)
        {
            <div class="connector-modal-backdrop" @onclick="CloseConnector">
                <article class="connector-modal panel" @onclick:stopPropagation>
                    <div class="panel-heading"><div><MudText Typo="Typo.h5">@Text["Conectar"] @_selected.DisplayName</MudText><MudText Typo="Typo.body2">@Text["As credenciais sao enviadas diretamente ao plugin e nunca sao persistidas pelo Core."]</MudText></div><MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseConnector" /></div>
                    @foreach (var field in _selected.CredentialFields ?? [])
                    {
                        <MudTextField T="string" Value="@Credential(field.Name)" ValueChanged="value => SetCredential(field.Name, value)" Label="@field.Label" Variant="Variant.Outlined" Required="@field.Required" InputType="@(field.Secret ? InputType.Password : InputType.Text)" Class="mb-3" />
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth Disabled="_connecting" OnClick="AuthenticateAsync">@(_connecting ? Text["Autenticando..."] : Text["Autenticar e conectar"])</MudButton>
                </article>
            </div>
        }
    }
</div>
</AppShellLayout>

@code {
    private bool CanWrite => Auth.CurrentUser?.Roles.Any(x => x is "Admin" or "Vendedor") == true;
    [SupplyParameterFromQuery] public bool Connected { get; set; }
    [SupplyParameterFromQuery] public string? OAuthError { get; set; }
    [SupplyParameterFromQuery] public string? OAuthMessage { get; set; }
    private ConnectorDescriptorModel[] _available = [];
    private MarketplaceConnectionModel[] _connections = [];
    private ConnectorDescriptorModel? _selected;
    private readonly Dictionary<string, string> _credentials = new(StringComparer.OrdinalIgnoreCase);
    private bool _loading = true;
    private bool _connecting;
    private Guid? _syncingId;
    private string? _oauthConnector;
    private const string MercadoLivreLogo = "https://res.cloudinary.com/lz9vero5/image/upload/v1784441482/191761039894-Mercado-Libre-removebg-preview_wzz6x3.png";

    protected override async Task OnInitializedAsync()
    {
        if (!OperatingSystem.IsBrowser())
            return;
        await ReloadAsync(); _loading = false;
        if (Connected) Snackbar.Add("Mercado Livre conectado com sucesso.", Severity.Success);
        if (!string.IsNullOrWhiteSpace(OAuthError))
            Snackbar.Add($"Nao foi possivel concluir o OAuth: {OAuthError}. {OAuthMessage}", Severity.Error);
    }
    private async Task ReloadAsync() { var available = await ConnectorsService.GetAvailableAsync(); if (available.Succeeded) _available = available.Value!; var connections = await ConnectorsService.GetConnectionsAsync(); if (connections.Succeeded) _connections = connections.Value!; }
    private static bool IsMercadoLivre(string name) => name.Contains("MercadoLivre", StringComparison.OrdinalIgnoreCase);
    private static string Initials(string name) => name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant();
    private static Color StatusColor(string status) => status switch { "Connected" => Color.Success, "Error" => Color.Error, _ => Color.Default };
    private async Task ConnectAsync(ConnectorDescriptorModel connector) { if (connector.UsesOAuth) { _oauthConnector = connector.Name; var result = await ConnectorsService.StartOAuthAsync(connector.Name); if (result.Succeeded) Navigation.NavigateTo(result.Value!.AuthorizationUrl, forceLoad: true); else { _oauthConnector = null; Snackbar.Add(result.Error!, Severity.Error); } return; } _selected = connector; _credentials.Clear(); }
    private void CloseConnector() => _selected = null;
    private string Credential(string name) => _credentials.GetValueOrDefault(name, string.Empty);
    private void SetCredential(string name, string value) => _credentials[name] = value;
    private async Task AuthenticateAsync() { if (_selected is null) return; _connecting = true; var result = await ConnectorsService.AuthenticateAsync(_selected.Name, _credentials); _connecting = false; Snackbar.Add(result.Succeeded ? $"{_selected.DisplayName} conectado com sucesso." : result.Error!, result.Succeeded ? Severity.Success : Severity.Error); if (result.Succeeded) { _selected = null; await ReloadAsync(); } }
    private async Task SyncAsync(MarketplaceConnectionModel connection) { _syncingId = connection.Id; var result = await ConnectorsService.SyncAsync(connection.Id, DateTimeOffset.Now.AddDays(-30)); _syncingId = null; Snackbar.Add(result.Succeeded ? $"{connection.ConnectorName} sincronizado." : result.Error!, result.Succeeded ? Severity.Success : Severity.Error); if (result.Succeeded) await ReloadAsync(); }
}
